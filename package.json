{
  "name": "foundryvtt-ai-gateway",
  "version": "0.2.0",
  "private": true,
  "description": "Functional gateway and contracts for an AI Pawn that legitimately plays alongside a human in Foundry VTT",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run check:phase1-spike",
    "check:phase1-spike": "node --check spikes/phase1/local-probe/server.mjs && node --check spikes/phase1/player-client-module/pawn-spike.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
