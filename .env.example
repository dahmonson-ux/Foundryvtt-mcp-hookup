# Copy to .env and replace placeholders locally.
# Never commit real credentials, tokens, tunnel URLs, IP addresses, or absolute file paths.

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001
GATEWAY_LOG_LEVEL=info

# Example only. Generate a unique secret for local use.
GATEWAY_AUTH_SECRET=replace-me

# Optional adapter-specific values should remain local.
FOUNDRY_BASE_URL=http://127.0.0.1:30000
