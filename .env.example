# Copy this file to .env only when a concrete runtime needs it.
# Never commit the real .env file.
# Never commit credentials, tokens, session data, private paths, or campaign secrets.

# Reference gateway development settings.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001
GATEWAY_LOG_LEVEL=info
GATEWAY_AUTH_SECRET=INSERT_GATEWAY_AUTH_SECRET_HERE

# Actor assigned to the AI Pawn.
AI_ACTOR_UUID=INSERT_AI_ACTOR_UUID_HERE

# Optional local/solo Foundry adapter settings.
# These are meaningful only when the chosen connection implementation uses them.
FOUNDRY_BASE_URL=INSERT_FOUNDRY_BASE_URL_HERE
FOUNDRY_BRIDGE_SECRET=INSERT_FOUNDRY_BRIDGE_SECRET_HERE

# The remote-player transport is intentionally not fixed yet.
# Add transport-specific settings only after the Phase 1 connection spike.
