# Copy this file to .env and replace only the placeholders needed for your mode.
# Never commit the real .env file.
# Never commit real credentials, tokens, private paths, or browser session data.

# ---------------------------------------------------------------------------
# Solo/local gateway configuration
# ---------------------------------------------------------------------------
# Used when Foundry and the AI tooling are running on the same machine or
# trusted local environment.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001
GATEWAY_LOG_LEVEL=info

# Required once you actually run a custom gateway/server process.
GATEWAY_AUTH_SECRET=INSERT_GATEWAY_AUTH_SECRET_HERE

# Optional transport-owned per-agent keys for custom transports.
AGENT_X_API_KEY=INSERT_AGENT_X_API_KEY_HERE
AGENT_Y_API_KEY=INSERT_AGENT_Y_API_KEY_HERE
AGENT_Z_API_KEY=INSERT_AGENT_Z_API_KEY_HERE

# Local Foundry adapter settings for the solo/local bridge path.
FOUNDRY_BASE_URL=INSERT_FOUNDRY_BASE_URL_HERE

# Required only if your local Foundry bridge/module uses a shared secret.
FOUNDRY_BRIDGE_SECRET=INSERT_FOUNDRY_BRIDGE_SECRET_HERE

# ---------------------------------------------------------------------------
# Remote-player shared-controller mode
# ---------------------------------------------------------------------------
# Used on a player's computer when Foundry itself is remote and the player is
# already logged into the game in their browser.
#
# No Foundry API key, password, cookie, or relay credential is copied into the
# local MCP/Pawn runner. Authentication stays inside the browser session.
#
# This identifies which Actor the AI controls. The browser-side Foundry module
# must verify that the currently logged-in player can control this Actor.
AI_ACTOR_UUID=INSERT_AI_ACTOR_UUID_HERE

# Local-only companion endpoint for the browser-side player module and local
# MCP/Pawn runner. Do not expose this endpoint to the public internet.
PLAYER_CLIENT_BRIDGE_HOST=127.0.0.1
PLAYER_CLIENT_BRIDGE_PORT=3001
