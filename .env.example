# Copy this file to .env and replace every INSERT_* placeholder locally.
# Never commit the real .env file.
# Never commit real credentials, tokens, tunnel URLs, private IPs, or absolute file paths.

# ---------------------------------------------------------------------------
# Local/solo gateway configuration
# ---------------------------------------------------------------------------
# These values are for a gateway/server process you run yourself.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001
GATEWAY_LOG_LEVEL=info

# REQUIRED once you actually run a gateway/server process.
GATEWAY_AUTH_SECRET=INSERT_GATEWAY_AUTH_SECRET_HERE

# OPTIONAL: transport-owned per-agent keys if your local transport uses them.
AGENT_X_API_KEY=INSERT_AGENT_X_API_KEY_HERE
AGENT_Y_API_KEY=INSERT_AGENT_Y_API_KEY_HERE
AGENT_Z_API_KEY=INSERT_AGENT_Z_API_KEY_HERE

# Local Foundry adapter settings.
FOUNDRY_BASE_URL=INSERT_FOUNDRY_BASE_URL_HERE

# REQUIRED only if your local Foundry bridge/module uses a shared secret.
FOUNDRY_BRIDGE_SECRET=INSERT_FOUNDRY_BRIDGE_SECRET_HERE

# OPTIONAL: only if you deliberately expose your own gateway remotely.
REMOTE_GATEWAY_URL=INSERT_REMOTE_GATEWAY_URL_HERE
REMOTE_GATEWAY_TOKEN=INSERT_REMOTE_GATEWAY_TOKEN_HERE

# ---------------------------------------------------------------------------
# Remote-player mode
# ---------------------------------------------------------------------------
# Use these on a PLAYER'S computer when their Pawn/AI reaches Foundry through
# the existing player-facing REST relay. They are NOT required for solo/local
# play on the Foundry host machine.
#
# The API key should be scoped by the relay to that player's Foundry user and
# target world. Do not use a GM-scoped key for a normal player Pawn.
FOUNDRY_RELAY_URL=INSERT_FOUNDRY_RELAY_URL_HERE
FOUNDRY_RELAY_API_KEY=INSERT_PLAYER_SCOPED_API_KEY_HERE

# The one Actor this player's AI/Pawn should control. The player may also own a
# separate human-controlled Actor in Foundry.
AI_ACTOR_UUID=INSERT_AI_ACTOR_UUID_HERE
