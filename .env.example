# Copy this file to .env only when a concrete runtime needs it.
# Never commit the real .env file.
# Never commit human or AI credentials, Cloudflare secrets, session data,
# private paths, Character Profiles, or campaign secrets.

# Generic gateway development settings.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001
GATEWAY_LOG_LEVEL=info
GATEWAY_AUTH_SECRET=INSERT_GATEWAY_AUTH_SECRET_HERE

# Pawn Actor assigned to the AI user.
AI_ACTOR_UUID=INSERT_AI_ACTOR_UUID_HERE

# Generic Foundry adapter development settings.
# Keep only if the concrete runtime uses them.
FOUNDRY_BASE_URL=INSERT_FOUNDRY_BASE_URL_HERE
FOUNDRY_BRIDGE_SECRET=INSERT_FOUNDRY_BRIDGE_SECRET_HERE

# Production access model:
#
# Human route:
#   Human -> human/player API access -> Human Foundry account -> Human Actor
#
# AI route:
#   AI -> Cloudflare MCP -> AI Foundry account -> Pawn Actor
#
# Add the actual Cloudflare MCP configuration keys only after the deployed
# MCP interface and authentication scheme are confirmed. Do not invent them.
